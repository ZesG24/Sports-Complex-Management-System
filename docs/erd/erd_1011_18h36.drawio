        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam roundcorner 5\nhide circle\n\nentity \&quot;loaisan\&quot; as loaisan {\n  * MaLoai\n  TenLoai\n  MoTa\n}\n\nentity \&quot;san\&quot; as san {\n  * MaSan\n  TenSan\n  GiaThue\n  TinhTrang\n  MoTa\n  MaLoai (FK)\n}\n\nentity \&quot;taikhoan\&quot; as taikhoan {\n  * MaTK\n  TenDangNhap\n  MatKhau\n  LoaiTK\n}\n\nentity \&quot;khachhang\&quot; as khachhang {\n  * MaKH\n  HoTen\n  SDT\n  Email\n  DiaChi\n  MaTK (FK)\n}\n\nentity \&quot;capnhapmatkhau\&quot; as capnhapmatkhau {\n  * id\n  MaKH (FK)\n  token\n  expires_at\n}\n\nentity \&quot;datsan\&quot; as datsan {\n  * MaDatSan\n  MaKH (FK)\n  MaSan (FK)\n  NgayDat\n  GioBatDau\n  GioKetThuc\n  TongTien\n  TrangThai\n  GhiChu\n}\n\nentity \&quot;hoadon\&quot; as hoadon {\n  * MaHD\n  MaDatSan (FK)\n  NgayLap\n  TongTien\n  GhiChu\n  MaBaoCao (FK)\n  TenPhuongThuc\n}\n\nentity \&quot;baocao\&quot; as baocao {\n  * MaBaoCao\n  NgayBaoCao\n  TongTienSan\n  TongTienDichVu\n}\n\nentity \&quot;dichvu\&quot; as dichvu {\n  * MaDV\n  TenDV\n  DonGia\n  MoTa\n  SoLuongTon\n}\n\nentity \&quot;nhaphang\&quot; as nhaphang {\n  * MaNhap\n  MaDV (FK)\n  SoLuongNhap\n  NgayNhap\n  GhiChu\n}\n\nentity \&quot;chitietdichvu\&quot; as chitietdichvu {\n  * MaDatSan (FK)\n  * MaDV (FK)\n  SoLuong\n  DonGia\n  ThanhTien\n}\n\nentity \&quot;danhgia\&quot; as danhgia {\n  * MaDG\n  MaKH (FK)\n  MaSan (FK)\n  Diem\n  NoiDung\n  NgayDanhGia\n  MaDatSan (FK)\n}\n\nentity \&quot;sanpham\&quot; as sanpham {\n  * MaSanPham\n  TenSanPham\n  MoTa\n  DonGia\n  DanhMuc\n  HinhAnh\n  NgayTao\n}\n\nentity \&quot;bienthesanpham\&quot; as bienthesanpham {\n  * MaBienThe\n  MaSanPham (FK)\n  KichThuoc\n  SoLuongTon\n}\n\nentity \&quot;nhapsanpham\&quot; as nhapsanpham {\n  * MaNhap\n  MaBienThe (FK)\n  SoLuongNhap\n  NhaCungCap\n  NgayNhap\n  GhiChu\n}\n\nentity \&quot;donhang\&quot; as donhang {\n  * MaDonHang\n  MaKH (FK)\n  TenKH\n  